# Federated Admin UI - Identity Provider Configuration
# Set VITE_IDP_PROVIDER to 'mock' or 'auth0'
VITE_IDP_PROVIDER=auth0

# Auth0 Tenant Domain (found on your Auth0 Application Settings page)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 Single Page Application Client ID
VITE_AUTH0_CLIENT_ID=
